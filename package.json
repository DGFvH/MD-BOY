{
  "name": "md-boy",
  "version": "0.1.0",
  "private": true,
  "description": "A simple, capable online Markdown editor with accounts and cloud storage.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --no-warnings --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --no-warnings server/index.js",
    "test": "node --no-warnings --test tests/api.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@playwright/test": "^1.63.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "supertest": "^7.3.0",
    "vite": "^8.3.1"
  }
}
