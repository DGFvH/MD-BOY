{
  "name": "Hashlite – Markdown editor",
  "short_name": "Hashlite",
  "description": "A free Markdown editor with live preview. Write or paste Markdown, then export to PDF, HTML, Word or Google Docs.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "My documents", "url": "/app" },
    { "name": "Markdown to Word", "url": "/markdown-to-word" },
    { "name": "CSV to Markdown table", "url": "/csv-to-markdown-table" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
