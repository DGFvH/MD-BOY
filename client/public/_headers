# Netlify and Cloudflare Pages response headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://vqyhrsjyyuespscyjzpd.supabase.co wss://vqyhrsjyyuespscyjzpd.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/app
  X-Robots-Tag: noindex
/app/*
  X-Robots-Tag: noindex
/s/*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
